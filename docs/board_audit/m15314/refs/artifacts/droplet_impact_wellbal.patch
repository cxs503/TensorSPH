+def hydrostatic_pressure(y: torch.Tensor, cfg: Config,
+                          level: float | None = None) -> torch.Tensor:
+    """Analytic hydrostatic pressure of a lake at rest at height ``y``.
+
+    ``p_h(y) = rho0 g max(0, level - y)``: the exact steady state of a
+    motionless free surface at ``level``, and the reference the well-balanced
+    pressure force of ``Config.equilibrium_level`` is taken against. Zero above
+    the level because a free surface cannot sustain tension.
+    """
+    top = cfg.equilibrium_level if level is None else float(level)
+    if top is None:
+        raise ValueError("hydrostatic_pressure needs a level "
+                         "(Config.equilibrium_level or the level argument)")
+    return cfg.rho0 * cfg.gravity * (top - y).clamp_min(0.0)
+
